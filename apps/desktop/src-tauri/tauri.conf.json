{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herdr Pocket",
  "version": "0.2.42",
  "identifier": "dev.crosery.herdrpocket.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Herdr Pocket",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: pocket-local: http://pocket-local.localhost https: http:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob: pocket-local: http://pocket-local.localhost https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost pocket-local: http://pocket-local.localhost https: wss: http: ws:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'self' blob: data: about: pocket-local: http://pocket-local.localhost https: http:",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Crosery",
    "homepage": "https://github.com/Crosery/herdr-pocket",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Crosery. Licensed under AGPL-3.0-only.",
    "shortDescription": "Herdr Pocket - multi-computer coding agent viewer and voice controller",
    "longDescription": "View and control Claude Code, Codex, Gemini CLI and other coding agents running in herdr across all your computers, with live terminal/chat streams and the Xiaoyang realtime voice assistant.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "headerImage": "windows/nsis-header.bmp"
      },
      "wix": {
        "language": "zh-CN",
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional"
      }
    }
  }
}
