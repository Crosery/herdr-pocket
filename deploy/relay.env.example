# /etc/herdr-pocket/relay.env  (chmod 600). With Docker: relay.env next to compose.yml.
# scripts/install-relay.sh writes it for you; docs/deploy/ has every way to run the relay.
# The Docker image sets POCKET_HOST=0.0.0.0, POCKET_PORT=7420 and POCKET_DB=/data/relay.db
# itself, so leave those three out there.
POCKET_PORT=7420
POCKET_HOST=127.0.0.1
POCKET_DB=/var/lib/herdr-pocket/relay.db
# The address phones and computers use; QR codes and invite links carry it.
POCKET_PUBLIC_URL=https://pocket.example.com
# 1 behind Caddy, nginx or a Cloudflare Tunnel (trust X-Forwarded-For/-Proto); 0 when exposed directly.
POCKET_TRUST_PROXY=1
# `herdr-pocket-relay update` installs releases from this GitHub repository (a fork, say).
# HERDR_POCKET_REPO=Crosery/herdr-pocket
# Optional. A fresh relay prints a one-time setup code and link for its first
# device, so pairing does not need it. Only the /admin dashboard and the admin
# APIs do; at least 24 characters: openssl rand -hex 24
POCKET_ADMIN_TOKEN=
# Time zone for the times the assistant says and the reminders it sets (an IANA
# name). Default Asia/Shanghai; other zones are called 当地时间 instead of 北京时间.
# POCKET_TIMEZONE=Asia/Shanghai

# Optional JSON file with the same text-model and voice settings (docs/config.md).
# A variable set to a non-empty value here wins over the file.
# POCKET_CONFIG=/etc/herdr-pocket/relay.json

# The app's Settings can change models, keys, voice and prompts; that overrides
# what this file sets until a phone resets it. Keys set from a phone are sealed
# with <database>.key next to the database: back it up together with the database.

# Optional private folder of prompts: each <id>.md there replaces the shipped
# one in apps/relay/src/assistant/prompts/ (docs/config.md, "Prompts").
# POCKET_PROMPTS_DIR=/etc/herdr-pocket/prompts

# =============================================================================
# Text assistant
# =============================================================================
# Models to use, in order: when one fails or gives no first token in time, the
# next one answers. Each entry is provider:model (provider ids below); an entry
# without a provider goes to POCKET_ASSISTANT_PROVIDER. Without any model the
# assistant can only explain that it is not set up. docs/config.md lists every
# provider and option.
POCKET_ASSISTANT_MODELS=
# POCKET_ASSISTANT_NAME=小羊
# Give up on a model with no first token after this many ms (default 25000).
# POCKET_ASSISTANT_FIRST_TOKEN_MS=25000
# never (default): the assistant acts at once. always: it asks before acting on
# agents in typed chats. Calls never wait. The app's Settings toggle
# "小羊动手前先问我" and /admin override this; the override is kept in the relay database.
POCKET_ASSISTANT_CONFIRM=never

# --- Provider keys: set the ones your models use ---
# POCKET_ANTHROPIC_API_KEY=
# POCKET_OPENAI_API_KEY=
# POCKET_DEEPSEEK_API_KEY=
# Qwen: Alibaba Cloud Model Studio (DashScope); keys belong to one region.
# POCKET_QWEN_API_KEY=
# Kimi
# POCKET_MOONSHOT_API_KEY=
# GLM
# POCKET_ZHIPU_API_KEY=
# POCKET_SILICONFLOW_API_KEY=
# Doubao: Volcengine Ark
# POCKET_VOLCENGINE_API_KEY=
# POCKET_OPENROUTER_API_KEY=
# POCKET_GEMINI_API_KEY=
# Ollama needs no key. From inside Docker it is not on localhost:
# POCKET_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- International endpoints instead of the mainland-China defaults ---
# POCKET_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# POCKET_MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# POCKET_ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
# POCKET_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# --- Extra request fields for one provider (JSON, keep the single quotes) ---
# POCKET_OPENAI_EXTRA_BODY='{"reasoning_effort":"low"}'

# --- Your own gateway: any OpenAI- or Anthropic-compatible endpoint ---
# Entries without a provider prefix go here unless POCKET_ASSISTANT_PROVIDER says otherwise.
# POCKET_ASSISTANT_URL=https://llm.example.com
# POCKET_ASSISTANT_KEY=
# anthropic (default here: POST {url}/v1/messages) or openai (POST {url}/chat/completions)
# POCKET_ASSISTANT_PROTOCOL=anthropic
# POCKET_ASSISTANT_USER_AGENT=
# More gateways get an id of your choice, e.g. "mygw" used as mygw:some-model:
# POCKET_MYGW_BASE_URL=https://llm2.example.com/v1
# POCKET_MYGW_API_KEY=

# --- Examples ---
# DeepSeek alone:
#   POCKET_DEEPSEEK_API_KEY=sk-...
#   POCKET_ASSISTANT_MODELS=deepseek:deepseek-flash
# Qwen first, Kimi when Qwen fails:
#   POCKET_ASSISTANT_MODELS=qwen:qwen3.7-plus,moonshot:kimi-k3
# A local model:
#   POCKET_ASSISTANT_MODELS=ollama:qwen3:8b

# =============================================================================
# Voice calls
# =============================================================================
# moss-live (default, recommended) or openai-realtime. Off without a key.
# POCKET_VOICE_PROVIDER=moss-live

# --- MOSS-Live: key from platform.mosi.cn -> API Keys ---
POCKET_VOICE_KEY=
# POCKET_VOICE_VOICE=
# Speaking rate 0.5-1.5; default 1.1, 1 is normal.
# POCKET_VOICE_SPEED=1.1
# POCKET_VOICE_URL=wss://api.mosi.cn/v1/realtime
# POCKET_VOICE_MODEL=moss-live-1.0
# The older names POCKET_MOSS_KEY, POCKET_MOSS_URL, POCKET_MOSS_MODEL,
# POCKET_MOSS_VOICE and POCKET_MOSS_SPEED still work for MOSS-Live.

# --- OpenAI Realtime protocol: OpenAI, Azure OpenAI ---
# POCKET_VOICE_PROVIDER=openai-realtime
# POCKET_VOICE_KEY=
# POCKET_VOICE_MODEL=gpt-realtime
# POCKET_VOICE_VOICE=marin
# Speech-to-text for captions of what you say; none turns captions off.
# POCKET_VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# POCKET_VOICE_LANGUAGE=zh
# server_vad or semantic_vad
# POCKET_VOICE_VAD=server_vad
# Azure OpenAI: your resource, the deployment name as the model, the api-key header.
# POCKET_VOICE_URL=wss://<resource>.openai.azure.com/openai/v1/realtime
# POCKET_VOICE_MODEL=<deployment>
# POCKET_VOICE_AUTH=api-key
